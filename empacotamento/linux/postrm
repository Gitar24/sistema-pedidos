#!/bin/sh
set -e

if [ "$1" = remove ]; then
    deb-systemd-helper disable comandas.socket comandas.service >/dev/null
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
    fi
fi
if [ "$1" = purge ]; then
    deb-systemd-helper purge comandas.socket comandas.service >/dev/null
fi
